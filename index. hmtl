.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{padding:11px 18px;border-radius:9px;font-weight:700;font-size:.9rem;display:inline-block}
.primary{background:var(--mint);color:#07151c}.outline{border:1px solid var(--line)}.outline:hover{border-color:var(--mint);color:var(--mint)}
.network{height:340px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(145deg,#142a43,#0c1b2d);display:grid;place-items:center;position:relative;overflow:hidden}
.network:before,.network:after{content:"";position:absolute;width:250px;height:250px;border:1px solid #68aaff33;border-radius:50%}.network:after{width:350px;height:350px}
.diagram{width:250px;height:230px;position:relative;z-index:1}.node{position:absolute;width:55px;height:55px;border-radius:15px;background:#193651;border:1px solid #39d8c577;color:var(--mint);display:grid;place-items:center;font-size:1.4rem}
.center{width:75px;height:75px;left:87px;top:78px;font-size:1.8rem;background:#39d8c522}.n1{top:0;left:0}.n2{top:0;right:0}.n3{bottom:0;left:0}.n4{bottom:0;right:0}
.wire{position:absolute;width:112px;height:2px;background:linear-gradient(90deg,transparent,var(--blue),var(--mint))}
.w1{left:42px;top:47px;transform:rotate(38deg)}.w2{left:137px;top:108px;transform:rotate(-38deg)}.w3{left:42px;top:182px;transform:rotate(-38deg)}.w4{left:137px;top:124px;transform:rotate(38deg)}
section.content{padding:72px 0}.label{font-size:.75rem;color:var(--mint);font-weight:800;letter-spacing:.16em;text-transform:uppercase}
h2{font-size:clamp(2rem,4vw,2.7rem);margin:7px 0 25px;letter-spacing:-.04em}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}.card{background:#102137cc;border:1px solid var(--line);border-radius:17px;padding:25px}.card p{color:var(--muted)}
.facts{display:grid;grid-template-columns:1fr 1fr;gap:12px}.fact{background:#162b43;padding:14px;border-radius:11px}.fact small{display:block;color:var(--muted)}.fact strong{font-size:.92rem}
.skills{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.skill{background:var(--panel);border:1px solid var(--line);padding:22px;border-radius:15px}.icon{font-size:1.5rem}.skill h3,.project h3{margin:8px 0}.skill p,.project p{color:var(--muted);font-size:.91rem}
.tag{color:var(--mint);font-size:.73rem;letter-spacing:.08em}.projects{display:grid;grid-template-columns:1fr 1fr;gap:18px}.note{font-size:.83rem;color:var(--muted);margin-top:14px}
.contact{padding:30px;border:1px solid #39d8c555;border-radius:19px;background:linear-gradient(110deg,#39d8c51a,#68aaff12);display:flex;justify-content:space-between;align-items:center;gap:20px}
footer{border-top:1px solid var(--line);padding:23px 0;text-align:center;color:var(--muted);font-size:.85rem}
@media(max-width:740px){.hero{grid-template-columns:1fr;padding:60px 0}.grid2,.skills,.projects{grid-template-columns:1fr}.contact{align-items:flex-start;flex-direction:column}.links{gap:12px;font-size:.78rem}}
@media(max-width:430px){.wrap{width:calc(100% - 28px)}.facts{grid-template-columns:1fr}.links{gap:8px}.links a{font-size:.72rem}}
</style>
