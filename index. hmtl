:root{--bg:#081321;--panel:#102137;--text:#edf6ff;--muted:#9db0c5;--mint:#39d8c5;--blue:#68aaff;--line:rgba(170,200,230,.16)}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}
body{font-family:Inter,"Segoe UI",Arial,sans-serif;background:radial-gradient(circle at 85% 8%,#39d8c51c,transparent 27rem),var(--bg);color:var(--text);line-height:1.7}
a{color:inherit;text-decoration:none}.wrap{width:min(1060px,calc(100% - 40px));margin:auto}
header{position:sticky;top:0;z-index:5;background:#081321df;backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
nav{height:70px;display:flex;align-items:center;justify-content:space-between}.brand{font-weight:850;letter-spacing:.08em}.brand span,h1 span{color:var(--mint)}
.links{display:flex;gap:24px;color:var(--muted);font-size:.9rem}.links a:hover{color:var(--mint)}
.hero{min-height:620px;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:45px;padding:75px 0}
